#!/bin/sh
# Run the suite the way CI does before anything leaves this machine: the
# pinned tools from requirements-test.txt and an empty HOME, so no
# ~/.claude/webcompanion/config.json is reachable. A test that quietly leans
# on the local daemon fails here, not on main.
#
# CI also runs Python 3.9. A whole second run would double the wait, so 3.9
# gets a compile and a full collection — every test module and what it
# imports, loaded under 3.9 — which catches syntax and import-time breakage.
#
# Skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
home=$(mktemp -d)
trap 'rm -rf "$home"' EXIT
req=requirements-test.txt

fail() {
  tail -40 "$1" >&2
  echo "pre-push: $2 Push blocked." >&2
  exit 1
}

echo "pre-push: Python 3.9 — compiling and collecting..." >&2
{
  uv run -q --python 3.9 python -m compileall -q -x '/node_modules/' skills bin &&
  uv run -q --python 3.9 --with-requirements "$req" \
    env HOME="$home" \
    python -m pytest skills -q --collect-only -n 0 -p no:cacheprovider
} >"$home/out39" 2>&1 || fail "$home/out39" "the suite does not load under Python 3.9, as CI would find."

echo "pre-push: running the suite as CI would (no daemon of yours)..." >&2
uv run -q --python 3.12 --with-requirements "$req" \
  env HOME="$home" \
  python -m pytest skills -q -p no:cacheprovider >"$home/out" 2>&1 ||
  fail "$home/out" "the suite fails as it would on CI."
tail -1 "$home/out" >&2
