#!/bin/sh
# Run the suite before anything leaves this machine (there is no CI): the
# pinned tools from requirements-test.txt and an empty HOME, so no
# ~/.claude/webcompanion/config.json is reachable. A test that quietly leans
# on the local daemon fails here, not on main.
#
# Python 3.9 is the declared floor. A whole second run would double the wait,
# so 3.9 gets a compile and a full collection — every test module and what it
# imports, loaded under 3.9 — which catches syntax and import-time breakage.
#
# /audit-failing-tests runs the whole suite under 3.9 too, and fixes failures.
#
# Skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
# A push from a linked worktree hands this hook GIT_DIR. Left set, every test
# that runs git in a temp folder would write into this repository instead.
unset $(git rev-parse --local-env-vars)
home=$(mktemp -d)
trap 'rm -rf "$home"' EXIT
req=requirements-test.txt

fail() {
  tail -40 "$1" >&2
  echo "pre-push: $2 Push blocked." >&2
  exit 1
}

echo "pre-push: Python 3.9 — compiling and collecting..." >&2
{
  uv run -q --python 3.9 python -m compileall -q -x '/node_modules/' skills fleet bin &&
  uv run -q --python 3.9 --with-requirements "$req" \
    env HOME="$home" \
    python -m pytest skills fleet/tests -q --collect-only -n 0 -p no:cacheprovider
} >"$home/out39" 2>&1 || fail "$home/out39" "the suite does not load under Python 3.9."

echo "pre-push: running the suite (no daemon of yours)..." >&2
uv run -q --python 3.12 --with-requirements "$req" \
  env HOME="$home" \
  python -m pytest skills fleet/tests -q -p no:cacheprovider >"$home/out" 2>&1 ||
  fail "$home/out" "the suite fails."
tail -1 "$home/out" >&2
