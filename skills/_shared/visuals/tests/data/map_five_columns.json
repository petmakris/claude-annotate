{"title": "A checkout crosses five tiers and the browser never touches the database", "columns": ["Customer devices", "Edge and gateway", "Core services in the primary region", "Data stores and queues", "Third party vendors"], "boxes": [{"id": "web", "col": 0, "row": 0, "name": "Single page web application", "lines": ["`app.js` bundle served by the CDN", "React with a service worker"], "b": 1}, {"id": "ios", "col": 0, "row": 1, "name": "iOS and Android apps", "lines": ["native shells", "push token registration"], "b": 1}, {"id": "cdn", "col": 1, "row": 0, "name": "CDN", "lines": ["static assets", "edge cache"], "b": 2}, {"id": "gw", "col": 1, "row": 1, "name": "API gateway", "lines": ["`gateway/main.go`", "rate limits and routing per tenant"], "b": 2, "tone": "red", "rows": 2}, {"id": "auth", "col": 2, "row": 0, "name": "Identity service", "lines": ["`auth/`", "issues and verifies tokens"], "b": 3, "tone": "blue"}, {"id": "ord", "col": 2, "row": 1, "name": "Order orchestration service", "lines": ["`orders/`", "saga coordinator for the checkout"], "b": 3}, {"id": "inv", "col": 2, "row": 2, "name": "Inventory", "lines": ["`inventory/`", "stock reservation"], "b": 3, "tone": "amber"}, {"id": "pg", "col": 3, "row": 0, "name": "Primary Postgres cluster", "lines": ["accounts and orders", "three replicas"], "b": 4}, {"id": "kafka", "col": 3, "row": 1, "name": "Event bus", "lines": ["order events", "seven day retention"], "b": 4}, {"id": "redis", "col": 3, "row": 2, "name": "Redis", "lines": ["sessions and carts"], "b": 4}, {"id": "stripe", "col": 4, "row": 0, "name": "Payment provider", "lines": ["card authorisation", "billed per transaction"], "b": 5, "tone": "amber"}, {"id": "mail", "col": 4, "row": 1, "name": "Email vendor", "lines": ["receipts"], "b": 5}, {"id": "wh", "col": 4, "row": 2, "name": "Warehouse partner API", "lines": ["pick and pack"], "b": 5}], "zones": [{"label": "inside our VPC", "boxes": ["auth", "ord", "inv", "pg", "kafka", "redis"]}, {"label": "public