      "title": "A settings card you can try",
      "spec": {
        "title": "Notification preferences",
        "html": "<style>body{font:15px system-ui;margin:0;padding:18px;color:#1f2328}.row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #eee}.t{width:44px;height:24px;border-radius:12px;background:#ccc;position:relative;cursor:pointer}.t.on{background:#1a7f37}.t::after{content:\"\";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left .15s}.t.on::after{left:23px}.seg button{border:1px solid #ccc;background:#fff;padding:4px 10px}.seg button.on{background:#0969da;color:#fff;border-color:#0969da}[data-annotate-id]{cursor:pointer;padding:2px 6px;margin-left:-6px;border-radius:5px}[data-annotate-id]:hover{background:#ddebff}small{display:block;color:#57606a;font-size:13px;margin-top:2px}</style><h3 style=\"margin:0 0 8px\">Notification preferences</h3><div class=\"row\"><span data-annotate-id=\"email-digest\">Email digest</span><div class=\"t on\" id=\"email\" onclick=\"this.classList.toggle('on')\"></div></div><div class=\"row\"><span data-annotate-id=\"push\">Push on new order<small>Silent from 22:00 to 07:00</small></span><div class=\"t\" id=\"push\" onclick=\"this.classList.toggle('on')\"></div></div><div class=\"row\"><span>Frequency</span><div class=\"seg\"><button class=\"on\" onclick=\"sel(this)\">Daily</button><button onclick=\"sel(this)\">Hourly</button><button onclick=\"sel(this)\">Live</button></div></div><script>function sel(b){[...b.parentNode.children].forEach(x=>x.classList.remove(\"on\"));b.classList.add(\"on\")}</script>"
      }
    }
  ]
