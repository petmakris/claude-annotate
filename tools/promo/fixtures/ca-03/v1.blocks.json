     "lang": "python",
     "code": "def amount_cents(self) -> int:\n    return int(self.amount * 100)"
    },
    "after": {
     "label": "Proposed",
     "path": "billing/invoice.py",
     "lang": "python",
     "code": "def amount_cents(self) -> int:\n    return round_half_up(self.amount * 100)"
    }
