   "id": "section-2",
   "kind": "explain",
   "title": "Where a cent goes missing",
   "spec": {
    "file": "billing/invoice.py",
    "line": 12,
    "lang": "python",
    "code": "def amount_cents(self) -> int:\n    return int(self.amount * 100)",
    "notes": [
     {
      "line": 2,
      "span": "self.amount * 100",
      "label": "**still exact** \u2014 `amount` is a `Decimal`, so nothing is lost yet"
     },
     {
      "line": 2,
      "span": "int(",
      "label": "**cuts, never rounds** \u2014 `int` drops whatever is left after the point"
     }
    ]
   }
  },
  {
   "id": "section-3",
   "kind": "compare",
   "title": "Round once, in one place",
   "spec": {
