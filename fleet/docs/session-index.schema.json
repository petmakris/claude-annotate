{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "The session index: shapes of fleet/docs/session-index.md",
 "description": "Every shape the session index exchanges. Uses only the keywords fleet/tests/schema_check.py knows.",
 "$defs": {
  "sid": {
   "type": "string",
   "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{0,127}$"
  },
  "machine": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
  },
  "owner": {
   "type": "string",
   "pattern": "^(phone:prod|phone:dev:[a-z0-9]+|[a-z0-9][a-z0-9-]{0,62})$"
  },
  "env": {
   "type": "string",
   "pattern": "^(prod|dev:[a-z0-9]+)$"
  },
  "time": {
   "type": "number",
   "minimum": 0
  },
  "topic": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "host",
    "id"
   ],
   "properties": {
    "host": {
     "type": "string",
     "pattern": "^(prod|dev:[a-z0-9]+)$"
    },
    "id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    }
   }
  },
  "name_source": {
   "enum": [
    "",
    "manual",
    "custom",
    "topic",
    "job",
    "ai",
    "agent",
    "fleet",
    "registry",
    "prompt"
   ]
  },
  "kind": {
   "enum": [
    "chat",
    "job",
    "worker",
    "voice"
   ]
  },
  "where": {
   "enum": [
    "tmux",
    "window",
    "bg",
    "phone",
    "none",
    null
   ]
  },
  "observed": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "live",
    "state",
    "where",
    "tmux",
    "pid",
    "observed_at",
    "stale",
    "source"
   ],
   "properties": {
    "live": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "state": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "where": {
     "$ref": "#/$defs/where"
    },
    "tmux": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "pid": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    },
    "observed_at": {
     "anyOf": [
      {
       "$ref": "#/$defs/time"
      },
      {
       "type": "null"
      }
     ]
    },
    "stale": {
     "type": "boolean"
    },
    "source": {
     "enum": [
      "machine",
      "journal",
      "none"
     ]
    }
   }
  },
  "row": {
   "description": "A row of the hub's `sessions` table: durable facts only.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sid",
    "conversation",
    "name",
    "name_source",
    "kind",
    "env",
    "machine",
    "cwd",
    "account",
    "owner",
    "owner_since",
    "epoch",
    "continues",
    "superseded_by",
    "first_prompt",
    "last_prompt",
    "last_answer",
    "topic",
    "rc_name",
    "started",
    "updated",
    "ended",
    "end_reason",
    "description",
    "work"
   ],
   "properties": {
    "sid": {
     "$ref": "#/$defs/sid"
    },
    "conversation": {
     "$ref": "#/$defs/sid"
    },
    "name": {
     "type": "string",
     "maxLength": 200
    },
    "name_source": {
     "$ref": "#/$defs/name_source"
    },
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "env": {
     "$ref": "#/$defs/env"
    },
    "machine": {
     "$ref": "#/$defs/machine"
    },
    "cwd": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 4096
    },
    "account": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "owner": {
     "$ref": "#/$defs/owner"
    },
    "owner_since": {
     "$ref": "#/$defs/time"
    },
    "epoch": {
     "type": "integer",
     "minimum": 1
    },
    "continues": {
     "anyOf": [
      {
       "$ref": "#/$defs/sid"
      },
      {
       "type": "null"
      }
     ]
    },
    "superseded_by": {
     "anyOf": [
      {
       "$ref": "#/$defs/sid"
      },
      {
       "type": "null"
      }
     ]
    },
    "first_prompt": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 300
    },
    "last_prompt": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "last_answer": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "topic": {
     "$ref": "#/$defs/topic"
    },
    "rc_name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "started": {
     "$ref": "#/$defs/time"
    },
    "updated": {
     "$ref": "#/$defs/time"
    },
    "ended": {
     "anyOf": [
      {
       "$ref": "#/$defs/time"
      },
      {
       "type": "null"
      }
     ]
    },
    "end_reason": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "description": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 2000
    },
    "work": {
     "type": "boolean"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "work": {
        "const": true
       }
      },
      "required": [
       "work"
      ]
     },
     "then": {
      "properties": {
       "first_prompt": {
        "type": "null"
       },
       "last_prompt": {
        "type": "null"
       },
       "last_answer": {
        "type": "null"
       },
       "cwd": {
        "type": "null"
       },
       "account": {
        "type": "null"
       },
       "description": {
        "type": "null"
       },
       "rc_name": {
        "type": "null"
       },
       "name_source": {
        "not": {
         "enum": [
          "ai",
          "registry",
          "prompt"
         ]
        }
       }
      }
     }
    }
   ]
  },
  "list_row": {
   "description": "A row as a list gives it: durable facts, observed facts, key, head, chain.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sid",
    "conversation",
    "name",
    "name_source",
    "kind",
    "env",
    "machine",
    "cwd",
    "account",
    "owner",
    "owner_since",
    "epoch",
    "continues",
    "superseded_by",
    "first_prompt",
    "last_prompt",
    "last_answer",
    "topic",
    "rc_name",
    "started",
    "updated",
    "ended",
    "end_reason",
    "description",
    "work",
    "observed",
    "key",
    "head",
    "chain"
   ],
   "properties": {
    "sid": {
     "$ref": "#/$defs/sid"
    },
    "conversation": {
     "$ref": "#/$defs/sid"
    },
    "name": {
     "type": "string",
     "maxLength": 200
    },
    "name_source": {
     "$ref": "#/$defs/name_source"
    },
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "env": {
     "$ref": "#/$defs/env"
    },
    "machine": {
     "$ref": "#/$defs/machine"
    },
    "cwd": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 4096
    },
    "account": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "owner": {
     "$ref": "#/$defs/owner"
    },
    "owner_since": {
     "$ref": "#/$defs/time"
    },
    "epoch": {
     "type": "integer",
     "minimum": 1
    },
    "continues": {
     "anyOf": [
      {
       "$ref": "#/$defs/sid"
      },
      {
       "type": "null"
      }
     ]
    },
    "superseded_by": {
     "anyOf": [
      {
       "$ref": "#/$defs/sid"
      },
      {
       "type": "null"
      }
     ]
    },
    "first_prompt": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 300
    },
    "last_prompt": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "last_answer": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "topic": {
     "$ref": "#/$defs/topic"
    },
    "rc_name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "started": {
     "$ref": "#/$defs/time"
    },
    "updated": {
     "$ref": "#/$defs/time"
    },
    "ended": {
     "anyOf": [
      {
       "$ref": "#/$defs/time"
      },
      {
       "type": "null"
      }
     ]
    },
    "end_reason": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "description": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 2000
    },
    "work": {
     "type": "boolean"
    },
    "observed": {
     "$ref": "#/$defs/observed"
    },
    "key": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[0-9A-Za-z][0-9A-Za-z_-]{0,127}$"
    },
    "head": {
     "type": "boolean"
    },
    "chain": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/sid"
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "work": {
        "const": true
       }
      },
      "required": [
       "work"
      ]
     },
     "then": {
      "properties": {
       "first_prompt": {
        "type": "null"
       },
       "last_prompt": {
        "type": "null"
       },
       "last_answer": {
        "type": "null"
       },
       "cwd": {
        "type": "null"
       },
       "account": {
        "type": "null"
       },
       "description": {
        "type": "null"
       },
       "rc_name": {
        "type": "null"
       },
       "name_source": {
        "not": {
         "enum": [
          "ai",
          "registry",
          "prompt"
         ]
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "work": {
        "const": true
       }
      },
      "required": [
       "work"
      ]
     },
     "then": {
      "properties": {
       "observed": {
        "properties": {
         "tmux": {
          "type": "null"
         }
        }
       }
      }
     }
    }
   ]
  },
  "cache_row": {
   "description": "One file `$FLEET_HOME/index/cache/<sid>.json`. On the writing machine a work row may be whole.",
