    },
    "last_prompt": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "last_answer": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "topic": {
     "$ref": "#/$defs/topic"
    },
    "rc_name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 200
    },
    "started": {
     "$ref": "#/$defs/time"
    },
    "updated": {
     "$ref": "#/$defs/time"
    },
    "ended": {
     "anyOf": [
      {
       "$ref": "#/$defs/time"
      },
      {
       "type": "null"
      }
     ]
    },
    "end_reason": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "description": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 2000
    },
    "work": {
     "type": "boolean"
    },
    "v": {
     "const": 1
    },
    "cached_at": {
     "$ref": "#/$defs/time"
    },
    "source": {
     "enum": [
      "hub",
      "local"
     ]
    }
   }
  },
  "journal_fields": {
   "description": "The only keys a journal entry may carry. Never owner, epoch, env, machine or chain fields.",
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 200
    },
    "name_source": {
     "$ref": "#/$defs/name_source"
    },
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "cwd": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 4096
    },
    "account": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "first_prompt": {
     "type": [
