   "additionalProperties": false,
   "required": [
    "v",
    "sid",
    "conversation",
    "owner",
    "epoch",
    "owner_since",
    "name",
    "name_source",
    "kind",
    "env",
    "machine",
    "work",
    "superseded_by",
    "cached_at",
    "source"
   ],
   "properties": {
    "sid": {
     "$ref": "#/$defs/sid"
    },
    "conversation": {
     "$ref": "#/$defs/sid"
    },
    "name": {
     "type": "string",
     "maxLength": 200
    },
    "name_source": {
     "$ref": "#/$defs/name_source"
    },
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "env": {
     "$ref": "#/$defs/env"
    },
    "machine": {
