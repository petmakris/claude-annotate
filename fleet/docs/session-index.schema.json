  "take_reply": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "ok",
      "sid",
      "owner",
      "epoch",
      "owner_since",
      "previous_owner",
      "conversation"
     ],
     "properties": {
      "ok": {
       "const": true
      },
      "sid": {
       "$ref": "#/$defs/sid"
      },
      "owner": {
       "$ref": "#/$defs/owner"
      },
