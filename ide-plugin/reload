#!/usr/bin/env bash
# Refresh the installed plugin so a plain IntelliJ restart picks up your changes.
#
# Two steps, and the second is the one that used to be manual:
#   1. Gradle's prepareSandbox copies the plugin jar AND its dependency jars
#      (commonmark, gson) into .intellijPlatform/sandbox/<IU-version>/...
#   2. Point the JetBrains config dir's plugin symlink at that sandbox.
#
# Step 2 has to run every time because the sandbox directory is named after the
# IDE BUILD. An IDE upgrade makes prepareSandbox write to a brand-new sandbox
# while the symlink still points at the old one — the IDE then silently loads a
# stale jar, with no error anywhere. That cost a day once: a 262 IDE kept
# loading a jar from a 261 sandbox, 81 commits behind, and every fix "did
# nothing". Linking here means the trap cannot come back.
#
# Usage:  ./reload          then restart IntelliJ
#         ./reload --watch  rebuild on every save; then you ONLY ever restart
#                           (the link is set once up front, then watched)
set -euo pipefail
cd "$(dirname "$0")"

SANDBOX_ROOT=".intellijPlatform/sandbox/claude-ide-review"

# The JetBrains config root, per-OS.
config_root() {
  case "$(uname -s)" in
    Darwin)  printf '%s' "$HOME/Library/Application Support/JetBrains" ;;
    Linux)   printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/JetBrains" ;;
    *)       printf '%s' "${APPDATA:-$HOME/AppData/Roaming}/JetBrains" ;;
  esac
}

# The IDE this build resolved against, and the config directory IT uses.
# product-info.json names that directory itself (dataDirectoryName), so this
# never has to guess from a version string.
ide_home() {
  local candidates=(
    "${IREVIEW_LOCAL_IDE_PATH:-}"
    "$HOME/Applications/IntelliJ IDEA.app/Contents"
    "/Applications/IntelliJ IDEA.app/Contents"
    "$HOME/AppData/Local/Programs/IntelliJ IDEA Ultimate"
    "/opt/intellij-idea-ultimate"
  )
  local c
  for c in "${candidates[@]}"; do
    [ -n "$c" ] && [ -d "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

data_dir_name() {
  local home="$1" info
  for info in "$home/Resources/product-info.json" "$home/product-info.json"; do
    [ -f "$info" ] || continue
    python3 - "$info" <<'PY'
import json, sys
print(json.load(open(sys.argv[1])).get("dataDirectoryName", ""))
PY
    return 0
  done
  return 1
}

# The sandbox prepareSandbox most recently wrote. Selected in python3 (already
# a dependency above) rather than stat: `stat -f` means "file system status" to
# GNU coreutils and "format" to BSD, so the usual `stat -f %m || stat -c %Y`
# fallback silently picks the wrong one on a Mac with coreutils installed.
newest_sandbox() {
  python3 - "$SANDBOX_ROOT" <<'NEWEST_PY'
import sys, pathlib
root = pathlib.Path(sys.argv[1])
cands = [p for p in root.glob("*/plugins/claude-ide-review") if p.is_dir()]
if not cands:
    sys.exit(1)
print(max(cands, key=lambda p: p.stat().st_mtime).resolve())
NEWEST_PY
}

link_plugin() {
  local home target root data link
  if ! home=$(ide_home); then
    echo "! No local IntelliJ found — sandbox built, but nothing to link it to." >&2
    echo "  Set IREVIEW_LOCAL_IDE_PATH to your IDE's Contents/ directory." >&2
    return 0
  fi
  if ! data=$(data_dir_name "$home") || [ -z "$data" ]; then
    echo "! Couldn't read dataDirectoryName from $home — link it by hand (see README)." >&2
    return 0
  fi
  if ! target=$(newest_sandbox); then
    echo "! No sandbox on disk — did prepareSandbox run?" >&2
    return 1
  fi
  root=$(config_root)
  link="$root/$data/plugins/claude-ide-review"
  mkdir -p "$root/$data/plugins"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "! $link exists and is NOT a symlink — leaving it alone." >&2
    echo "  Move it aside if you want ./reload to manage it." >&2
    return 0
  fi
  ln -sfn "$target" "$link"
  echo "✓ $data → $(basename "$(dirname "$(dirname "$target")")")"

  # Any OTHER config dir still pointing into this repo belongs to an IDE you no
  # longer run. Say so rather than leaving a second, stale link behind.
  local other
  for other in "$root"/*/plugins/claude-ide-review; do
    [ -L "$other" ] || continue
    [ "$other" = "$link" ] && continue
    case "$(readlink "$other")" in
      "$PWD"/*) echo "  note: $(basename "$(dirname "$(dirname "$other")")") also links here" \
                     "(stale IDE version — remove it if you no longer run that build)" ;;
    esac
  done
}

if [[ "${1:-}" == "--watch" ]]; then
  ./gradlew prepareSandbox
  link_plugin
  echo "Watching for changes — edit, then just restart IntelliJ. Ctrl-C to stop."
  exec ./gradlew -t prepareSandbox
fi

./gradlew prepareSandbox
link_plugin
echo "✓ Sandbox updated. Restart IntelliJ to load the new plugin."
